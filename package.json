{
  "name": "typeconfig",
  "version": "2.3.4",
  "description": "Config loader for Typescript",
  "main": "./dist/cjs/common.js",
  "module": "./dist/esm/common.js",
  "types": "./dist/cjs/common.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "dist/*"
      ],
      "*": [
        "dist/cjs/*"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/common.d.ts",
        "default": "./dist/esm/common.js"
      },
      "require": {
        "types": "./dist/cjs/common.d.ts",
        "default": "./dist/cjs/common.js"
      }
    },
    "./common": {
      "import": {
        "types": "./dist/esm/common.d.ts",
        "default": "./dist/esm/common.js"
      },
      "require": {
        "types": "./dist/cjs/common.d.ts",
        "default": "./dist/cjs/common.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/esm/web.d.ts",
        "default": "./dist/esm/web.js"
      },
      "require": {
        "types": "./dist/cjs/web.d.ts",
        "default": "./dist/cjs/web.js"
      }
    },
    "./src/*": {
      "import": {
        "types": "./dist/esm/src/*.d.ts",
        "default": "./dist/esm/src/*.js"
      },
      "require": {
        "types": "./dist/cjs/src/*.d.ts",
        "default": "./dist/cjs/src/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "common/",
    "node/",
    "web/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/mark-module-type.mjs dist/cjs commonjs",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/mark-module-type.mjs dist/esm module",
    "typecheck": "tsc",
    "lint": "eslint .",
    "build:test": "rimraf build && npm run build:test:cjs && npm run build:test:esm",
    "build:test:cjs": "tsc -p test/tsconfig.cjs.json && node scripts/mark-module-type.mjs build/test/cjs commonjs",
    "build:test:esm": "tsc -p test/tsconfig.esm.json && node scripts/mark-module-type.mjs build/test/esm module",
    "pretest": "npm run build:test",
    "test": "npm run test:cjs && npm run test:esm",
    "test:cjs": "c8 mocha --no-config --recursive \"build/test/cjs/test/**/*.spec.js\"",
    "test:esm": "mocha --no-config --recursive \"build/test/esm/test/**/*.spec.js\"",
    "test:ts": "mocha \"test/**/*.spec.ts\"",
    "test:package": "npm run build && mocha --no-config \"test/package/*.spec.mjs\" && attw --pack .",
    "prepublishOnly": "npm run lint && npm test && npm run test:package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpatrik/typeconfig.git"
  },
  "keywords": [
    "Typescript",
    "config"
  ],
  "author": "Patrik J. Braun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bpatrik/typeconfig/issues"
  },
  "homepage": "https://github.com/bpatrik/typeconfig#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "8.0.2",
    "@types/minimist": "1.2.5",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "chai": "5.2.1",
    "chai-as-promised": "8.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-chai-friendly": "1.2.1",
    "mocha": "12.0.3",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "minimist": "1.2.8"
  }
}
