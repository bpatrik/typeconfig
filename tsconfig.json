{
  // Base config used by the editor, type checking and ESLint.
  // The published builds use tsconfig.cjs.json and tsconfig.esm.json, the tests use test/tsconfig.*.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      // WebConfigLoader reads window.location
      "DOM"
    ],
    // Node20 allows the CommonJS test build to require() the ESM-only chai
    "module": "Node20",
    "moduleResolution": "Node16",
    "types": [
      "node",
      "mocha"
    ],
    "noImplicitAny": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // the property decorators install getters/setters on the prototype; [[Define]] class fields would shadow them
    "useDefineForClassFields": false,
    "sourceMap": true,
    "inlineSources": true,
    "noEmit": true
  },
  // lets mocha run the .ts specs directly (.mocharc.json, npm run test:ts):
  // the resolver maps the '.js' import specifiers to the .ts sources
  "ts-node": {
    "experimentalResolver": true
  },
  "include": [
    "common.ts",
    "node.ts",
    "web.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
